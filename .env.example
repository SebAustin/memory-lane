# Memory Lane environment (PLAN section 7). Copy to .env.local; never commit real values.
# Every variable is optional: with none set, the app runs in fixture mode (NFR-22).
# There are intentionally no NEXT_PUBLIC_ variables: nothing here reaches the browser.

# Qloo data source: fixture (default) | live. live is refused (boot error) until the live client lands (tickets 05 and 23).
QLOO_MODE=
QLOO_API_KEY=
QLOO_BASE_URL=

# LLM: gateway (default) | mock | off. mock needs ALLOW_MOCK_LLM=1; without it, or when deployed (VERCEL_ENV preview or production), it is a boot error.
LLM_MODE=
MODEL_ID=
JUDGE_MODEL_ID=
# Local and CI only. On Vercel the AI Gateway authenticates through OIDC.
AI_GATEWAY_API_KEY=

# Daily cap on live LLM runs (default 150).
LLM_DAILY_RUN_CAP=

# Rate limiting: on (default) | off. off throws at boot when deployed (VERCEL_ENV preview or production); E2E only.
RATE_LIMIT_MODE=
# Optional per-bucket overrides as <capacity>/<perMinutes>, e.g. RL_KIT_LIVE=6/10.
# Buckets: resolve, kit_live, kit_replay, baseline_live, baseline_replay, compare.
RL_RESOLVE=
RL_KIT_LIVE=
RL_KIT_REPLAY=
RL_BASELINE_LIVE=
RL_BASELINE_REPLAY=
RL_COMPARE=

# Comma-separated image hostnames allowed in the CSP img-src (empty until ticket 23).
QLOO_IMAGE_HOSTS=

# Dev and test only. Ignored, and logged by name, when deployed (VERCEL_ENV preview or production, set by Vercel).
ALLOW_MOCK_LLM=
QLOO_FIXTURE_FAULTS=
